+                    fill
+                    sizes="80px"
+                    className="duotone object-cover"
+                  />
+                </div>
+                <div className="min-w-0">
+                  <h3 className="t-display-tight text-xl leading-tight">{other.name}</h3>
+                  <p className="t-mono mt-2 text-[color:var(--page-faint)]">{other.duration}</p>
+                </div>
+                <span
+                  aria-hidden
