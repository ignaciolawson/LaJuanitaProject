# Copiar como `.env` EN LA RAIZ DEL REPO, en el servidor. El `.env` no se
# versiona nunca; este ejemplo si.
#
# Todos los valores de desarrollo commiteados en el repo son publicos y
# ninguno sirve aca.

# --- Que compose es el de este servidor ------------------------------------
# Compose lee esta variable del `.env`, asi que en el servidor un
# `docker compose ps|logs|exec` a secas ya apunta al stack de produccion.
# ⚠️ `scripts/backup.sh` DEPENDE de esto para encontrar el contenedor de la
# base: sin la linea, lee el compose de desarrollo, no ve nada corriendo y
# cae a un nombre de contenedor que en el servidor no existe.
COMPOSE_FILE=docker-compose.prod.yml

# --- La base ---------------------------------------------------------------
POSTGRES_DB=la_juanita
POSTGRES_USER=la_juanita
# ⚠️ OTRA, generada. `la_juanita` es la publica del repo.
#    openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR

# --- La firma de los tokens ------------------------------------------------
# ⚠️ Valor NUEVO. El del repo hay que darlo por conocido para siempre.
#    openssl rand -base64 48
JWT_SECRET=CAMBIAR

# --- El dominio ------------------------------------------------------------
# Con dominio:  DOMINIO=lajuanitastudio.com   (Caddy saca el certificado solo)
# Sin dominio todavia, para probar en HTTP:   DOMINIO=:80
DOMINIO=:80

# ⚠️ No hay variable para el mail de Let's Encrypt, a proposito: una variable
# vacia en la directiva `email` de Caddy NO toma default, es un error de
# sintaxis que deja el proxy en loop de reinicio. Si se la quiere, va escrita
# en el Caddyfile. Esta explicado ahi.

# --- CORS ------------------------------------------------------------------
# ⚠️ Tiene que ser EXACTAMENTE la direccion desde la que la gente abre el
# sitio: `https://lajuanitastudio.com`, o `http://<IP>` mientras no haya
# dominio. Medido el 2026-09-26: con un origen que no esta en esta lista,
# Spring corta el login con un 403 "Invalid CORS request" ANTES de mirar la
# contrasena, y las pantallas lo muestran como "Revisa el mail y la
# contrasena" (landing) y "No tenes permiso" (panel). O sea: parece una
# contrasena mal escrita y no lo es. Desde la compu anda y desde el celu no,
# si uno tiene el origen en la lista y el otro no.
CORS_ORIGENES=https://CAMBIAR-POR-EL-DOMINIO

# --- Archivos --------------------------------------------------------------
# Donde viven contratos y comprobantes EN EL HOST. Tiene que ser del uid 1001:
#     mkdir -p archivos && sudo chown 1001:1001 archivos
# ⚠️ Y `LAJUANITA_ARCHIVOS_DIR` de scripts/backup.sh tiene que apuntar aca, o
# el backup respalda una carpeta vacia y solo lo dice en su log.
ARCHIVOS_HOST=./archivos

AVISOS_ZONA=America/Argentina/Buenos_Aires
