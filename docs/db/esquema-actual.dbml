Table alumno {
  id_alumno bigint [pk, increment]
  id_usuario bigint [not null, unique]
  nivel_ingreso varchar(20)
  estado_alumno varchar(20) [not null, default: 'ACTIVO']
  fecha_ingreso date [not null, default: `CURRENT_DATE`]
  ultimo_contacto date
  instagram varchar(100)
}

Table aparicion_release {
  id_aparicion bigint [pk, increment]
  id_release bigint [not null]
  tipo_aparicion varchar(20) [not null]
  donde varchar(200) [not null]
  quien varchar(150)
  fecha date
  url varchar(500)
  notas text
  id_usuario_carga bigint
  fecha_creacion timestamptz [not null, default: `now()`]
  orden_relevancia smallint [note: 'generada:  CASE tipo_aparicion WHEN "RADIO"::text THEN 1 WHEN "SET"::text THEN 2 WHEN "PLAYLIST"::text THEN 3 ELSE 9 END']
}

Table artista {
  id_artista bigint [pk, increment]
  id_usuario bigint
  nombre_artistico varchar(150) [not null]
  nombre_real varchar(150)
  email_contacto varchar(150)
  telefono varchar(40)
  instagram varchar(100)
  confirmado boolean [not null, default: false]
  bio text
  fecha_alta timestamptz [not null, default: `now()`]
}

Table bloqueo_sala {
  id_bloqueo bigint [pk, increment]
  id_sala bigint [not null]
  id_usuario_registra bigint
  fecha_inicio date [not null]
  fecha_fin date [not null]
  hora_inicio time [not null, default: '00:00:00']
  hora_fin time [not null, default: '23:59:00']
  motivo text [not null]
  fecha_registro timestamptz [not null, default: `now()`]
  dias daterange [note: 'generada:  CASE WHEN (fecha_fin >= fecha_inicio) THEN daterange(fecha_inicio, fecha_fin, "[]"::text) ELSE NULL::daterange END']
  franja rango_horario [note: 'generada:  CASE WHEN (hora_fin > hora_inicio) THEN rango_horario(hora_inicio, hora_fin, "[)"::text) ELSE NULL::rango_horario END']
}

Table cancion_release {
  id_cancion bigint [pk, increment]
